# Environment variables for Ghost Ledger.
# Copy to .env.local and fill in. Never commit real values.
# Parsed by src/lib/env.ts (zod). Empty values count as unset.

# --- App runtime -------------------------------------------------------------
# ghost_app through Supabase's transaction pooler (port 6543). Username form:
# ghost_app.<project-ref>. The app connects only as this role.
DATABASE_URL=

# --- MCP server and agent ----------------------------------------------------
# ghost_readonly through the transaction pooler. SELECT only.
READONLY_DATABASE_URL=

# --- Admin scripts only (never the app) --------------------------------------
# Table owner, direct (session) connection, not the pooler. Used only by
# migrations, the seed, db:roles-login and the demo scripts.
ADMIN_DATABASE_URL=

# Login passwords that `npm run db:roles-login` sets on the runtime roles
# ghost_app and ghost_readonly. At least 16 characters each.
APP_DB_PASSWORD=
READONLY_DB_PASSWORD=
