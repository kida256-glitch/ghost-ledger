# Environment variables for Ghost Ledger.
# Copy to .env.local and fill in. Never commit real values.
# Parsed by src/lib/env.ts (zod). Empty values count as unset.

# --- App runtime -------------------------------------------------------------
# ghost_app through Supabase's transaction pooler (port 6543). Username form:
# ghost_app.<project-ref>. The app connects only as this role.
DATABASE_URL=

# --- MCP server and agent ----------------------------------------------------
# ghost_readonly through the transaction pooler. SELECT only.
READONLY_DATABASE_URL=

# --- Admin scripts only (never the app) --------------------------------------
# Table owner, direct (session) connection, not the pooler. Used only by
# migrations, the seed, db:roles-login and the demo scripts.
ADMIN_DATABASE_URL=
# PEM text of the Supabase CA (prod-ca-2021.crt). Required for every non-local
# database: connections verify the certificate and hostname. Public, not a secret.
# In PowerShell: $env:DATABASE_CA_CERT = Get-Content -Raw .\prod-ca-2021.crt
DATABASE_CA_CERT=

# Login passwords that `npm run db:roles-login` sets on the runtime roles
# ghost_app and ghost_readonly. At least 16 characters each.
APP_DB_PASSWORD=
READONLY_DB_PASSWORD=

# --- Leader sign-in (app, server only) and seed ------------------------------
# Supabase project URL: Supabase Auth for the dashboard, and the Auth admin API
# that db:seed uses to create the demo logins.
SUPABASE_URL=
# Publishable key (sb_publishable_...). Server only, never NEXT_PUBLIC_. It maps
# to the anon role, which has no table grants. Allowed on Vercel.
SUPABASE_PUBLISHABLE_KEY=
# Optional: if set, the login page shows the demo leaders' password (fictional group).
DEMO_LEADER_PASSWORD_HINT=
# SUPABASE_SERVICE_ROLE_KEY: set it ONLY in the shell that runs db:seed
# ($env:SUPABASE_SERVICE_ROLE_KEY = "..." in PowerShell, see DEMO.md).
# Never in this file or any .env file, never on Vercel, never committed. It
# bypasses RLS and every grant. The app refuses to start if it is set
# (src/lib/env.ts), and db:seed refuses if a .env file assigns it.
# SUPABASE_SERVICE_ROLE_KEY=
# Password for both demo leader logins (chair and treasurer). At least 12 characters.
DEMO_LEADER_PASSWORD=

# --- USSD ----------------------------------------------------------------------
# Requests allowed per phone number per 5 minutes (1 to 10000). Default 30.
USSD_RATE_LIMIT_MAX=
# --- Agent (ai-agent-mcp) -------------------------------------------------------
# "mock" (default: deterministic, no key needed) or "gemini".
AGENT_PROVIDER=
# Gemini only. Server only, never NEXT_PUBLIC_, never logged. Pick the model
# with npm run agent:smoke (lists the current models).
GEMINI_API_KEY=
AGENT_MODEL=
# Questions per leader per Kampala day (default 30) and output token cap (default 600).
AGENT_DAILY_LIMIT=
AGENT_MAX_OUTPUT_TOKENS=
# --- MCP server (npm run mcp) ----------------------------------------------------
# Group the read-only MCP tools are bound to (default TUBEERA). Uses READONLY_DATABASE_URL.
MCP_GROUP_CODE=
# --- Demo scripts ---------------------------------------------------------------
# Must be exactly `true` for `npm run demo:tamper` / `npm run demo:restore` to run.
ALLOW_TAMPER_DEMO=

# --- Hosted check ---------------------------------------------------------------
# Must be exactly `true` for `npm run hosted:check` (design §14.4).
ALLOW_HOSTED_CHECK=
# --- Integration tests ------------------------------------------------------------
# Defaults to local Supabase (postgresql://postgres:postgres@127.0.0.1:56322/postgres).
# Only 127.0.0.1 or localhost is accepted.
INTEGRATION_DATABASE_URL=
